
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "process",
            "command": "D:\\msys\\ucrt64\\bin\\cmake.exe",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}\\build",
                "-G", "Ninja",
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: Build",
            "type": "process",
            "command": "D:\\msys\\ucrt64\\bin\\cmake.exe",
            "args": [
                "--build", "${workspaceFolder}\\build"
            ],
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CMake: Run",
            "type": "process",
            "command": "${workspaceFolder}\\build\\bin\\Project.exe",
            "dependsOn": "CMake: Build",
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
